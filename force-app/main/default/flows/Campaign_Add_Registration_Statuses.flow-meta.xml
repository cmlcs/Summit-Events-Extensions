    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_Registration_Statuses</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.Summit_Events_Instance__c})) &amp;&amp; (ISNEW() || ISCHANGED({!$Record.Summit_Events_Instance__c}))</filterFormula>
